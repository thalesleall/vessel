{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vessel",
  "version": "0.1.1",
  "identifier": "dev.vessel.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vessel",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0d1017",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [],
    "category": "DeveloperTool",
    "shortDescription": "Terminal e SSH com sincronização criptografada self-hosted",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../../LICENSE-MIT": "LICENSE-MIT",
      "../../../LICENSE-APACHE": "LICENSE-APACHE"
    }
  }
}

# Public host name of the agent (DNS must point here; Caddy gets the certificate).
# It is also the OPAQUE server identity: changing it later invalidates every password.
VESSEL_DOMAIN=vessel.example.com

# open | invite-only | disabled
VESSEL_SIGNUPS=invite-only

VESSEL_NAME=Vessel

# Code the first account (the server admin) must enter. When unset, the agent generates one
# and prints it in its log until the first account exists: docker compose logs agent
# VESSEL_BOOTSTRAP_TOKEN=

# Whether a vault invite also admits a new account on an invite-only server (true/false).
# Set false on a hosted service where accounts are sold.
# VESSEL_VAULT_INVITE_SIGNUPS=true

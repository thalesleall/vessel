{
	servers {
		# Slow clients cannot hold connections open: headers and bodies must arrive in time.
		# The event WebSocket is long-lived but keeps pinging, so the idle limit does not cut it.
		timeouts {
			read_header 10s
			read_body 60s
			idle 5m
		}
	}
}

{$VESSEL_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		-Server
	}
	request_body {
		max_size 64MB
	}
	reverse_proxy agent:8080
}
